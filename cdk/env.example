# ============================================
# Service Keys Configuration
# ============================================
# Copy this file to .env and fill in your service keys
# Giống như .env ở Django source code
# 
# Infrastructure config (VPC, DB, ECS) được hardcode trong config.ts
# Chỉ service keys cần set ở đây

# Environment (optional - default: production)
CDK_ENVIRONMENT=production

# Domain Configuration (required)
CDK_DOMAIN_NAME=buikhanhhuy.com
CDK_ADMIN_SUBDOMAIN=admin
CDK_API_SUBDOMAIN=api

# ============================================
# Service Keys (từ external services)
# ============================================

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Firebase
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-credentials.json

# SMS Service
SMS_API_KEY=your-sms-api-key

# ============================================
# Note
# ============================================
# Infrastructure config (VPC, DB, ECS, etc.) được hardcode trong config.ts
# Nếu cần thay đổi, sửa trực tiếp trong lib/config.ts

